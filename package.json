{
  "name": "nocturne",
  "type": "module",
  "version": "1.0.0",
  "description": "Nocturne - a midnight-themed web proxy built on Ultraviolet + Epoxy + Bare-Mux + Wisp.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "build:sapphire": "esbuild node_modules/@x8r/sapphire/src/index.ts --bundle --format=esm --platform=browser --target=es2020 --alias:@mercuryworkshop/scramjet-controller=./build/scramjet-controller-shim.mjs --outfile=public/sapphire/sapphire.bundle.mjs --sourcemap",
    "build:assets": "node scripts/build-assets.mjs",
    "test:optimizations": "node --test tests/optimizations.test.mjs tests/chat-moderation.test.mjs"
  },
  "keywords": [
    "proxy",
    "epoxy",
    "wisp",
    "unblocker"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cap.js/wasm": "^0.0.7",
    "@mercuryworkshop/bare-mux": "^2.1.7",
    "@mercuryworkshop/epoxy-transport": "^3.0.1",
    "@mercuryworkshop/scramjet": "^2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "^0.0.14",
    "@mercuryworkshop/wisp-js": "^0.4.0",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10",
    "@x8r/sapphire": "^0.1.3",
    "animejs": "^4.5.0",
    "better-sqlite3": "^12.9.0",
    "cap-widget": "^0.1.56",
    "capjs-core": "^0.1.1",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "fetch-cookie": "^3.2.0",
    "groq-sdk": "^1.1.2",
    "javascript-obfuscator": "^5.4.3",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "ssh2": "^1.17.0",
    "tough-cookie": "^6.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
