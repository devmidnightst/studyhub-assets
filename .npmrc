# @x8r/sapphire@0.1.3 (latest) declares a stale peer on
# @mercuryworkshop/scramjet-controller@^0.0.13, but this project runs ^0.0.14.
# Without this, a plain `npm i` aborts with ERESOLVE and installs nothing.
#
# The mismatch is inert: build:sapphire aliases sapphire's controller import to
# build/scramjet-controller-shim.mjs, which re-exports the already-loaded
# self.$scramjetController global, so the npm copy is never bundled.
#
# Do NOT "fix" this with `npm i --force` - that satisfies the peer by
# downgrading scramjet-controller to 0.0.13.
legacy-peer-deps=true
